# =============================================================================
# Frontend — Astro build-time environment variables
# =============================================================================
# Copy this file to `.env` and fill in your values:
#   cp frontend/.env.example frontend/.env
#
# WARNING
#   Never commit `frontend/.env`. It contains secrets or service-specific values
#   that belong in encrypted infrastructure stores (see docs/env-management.md).
# =============================================================================

# Public site origin (used for absolute URLs, OG tags, sitemap, etc.)
PUBLIC_SITE_URL=https://www.newprojects.ma

# Backend read-API origin. The frontend calls this base URL for:
#   - search & filter results
#   - programme detail enrichment
#   - lead/inquiry form submissions
PUBLIC_API_URL=https://api.newprojects.ma

# Cloudflare Turnstile site key (public; safe to ship to browsers).
# Used on forms where we challenge users (inquiry form, etc.).
PUBLIC_TURNSTILE_SITE_KEY=

# PMTiles vector basemap endpoint.
# Served from Cloudflare R2; rendered client-side with MapLibre GL JS.
# Examples:
#   https://<bucket>.r2.dev/tiles/newprojects/{z}/{x}/{y}.pbf
PUBLIC_MAP_TILES_URL=

# Public media asset origin.
# Images and PDFs stored on R2, served via this base URL in <img src> etc.
PUBLIC_R2_MEDIA_URL=https://media.newprojects.ma

# Default content locale (ISO 639-1).
PUBLIC_DEFAULT_LOCALE=fr

# Supported locales for i18n routing/display.
PUBLIC_SUPPORTED_LOCALES=fr,en

# Optional Cloudflare Deploy Hook URL for rebuild triggers.
# Sent from Phoenix backend on publish events to trigger a new Astro build.
# Keep this value secret; it is effectively a bearer token for CI rebuilds.
CLOUDFLARE_DEPLOY_HOOK_URL=
