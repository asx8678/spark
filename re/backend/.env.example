# =============================================================================
# Backend — Phoenix runtime environment variables
# =============================================================================
# Copy this file to `.env` and fill in your values:
#   cp backend/.env.example backend/.env
#
# WARNING
#   Never commit `backend/.env`. It contains secrets and credentials.
#   See docs/env-management.md for how to store them on the Hetzner VPS
#   and in CI.
# =============================================================================

# Mix environment. Set from the shell or process manager (systemd/Docker).
# Allowed values: dev, test, prod.
MIX_ENV=prod

# Postgres connection string (required).
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Phoenix secret used to sign session cookies and CSRF tokens (required).
# Generate once with: openssl rand -base64 64
SECRET_KEY_BASE=

# Hostname for absolute URLs in emails and links.
PHX_HOST=newprojects.ma

# Bind port for Phoenix HTTP endpoint.
PORT=4000

# -----------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible object storage)
# Used for media uploads and, if needed, signed media delivery.
# -----------------------------------------------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=media

# -----------------------------------------------------------------------------
# Cloudflare Turnstile
# Server-side secret key for verifying tokens submitted from the frontend.
# -----------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=

# Cloudflare Deploy Hook URL for rebuild triggers (optional if used).
# If the backend triggers frontend rebuilds, store the hook URL here.
CLOUDFLARE_DEPLOY_HOOK_URL=

# -----------------------------------------------------------------------------
# SMTP (transactional email for inquiry notifications)
# -----------------------------------------------------------------------------
SMTP_ADAPTER=smtp
SMTP_RELAY=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@newprojects.ma
SMTP_FROM_NAME=newprojects.ma
