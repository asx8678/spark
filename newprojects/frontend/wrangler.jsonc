{
  // main: ./dist/_worker.js/index.js — omitted at build time (Astro adapter injects); custom entry in P4-E3
  "name": "immo-frontend",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/projects/*",
      "/listings/*",
      "/developers/*",
      "/fr/*",
      "/ar/*",
      "/en/*",
      "/__health"
    ]
  },
  "kv_namespaces": [
    { "binding": "FRESHNESS", "id": "<staging-kv-namespace-id>" }
  ],
  "vars": {
    "PUBLIC_ENVIRONMENT": "development"
  },
  "env": {
    "staging": {
      "name": "immo-frontend-staging",
      "vars": {
        "PUBLIC_ENVIRONMENT": "staging"
      },
      "kv_namespaces": [
        { "binding": "FRESHNESS", "id": "<staging-kv-namespace-id>" }
      ]
    },
    "production": {
      "name": "immo-frontend-production",
      "vars": {
        "PUBLIC_ENVIRONMENT": "production"
      },
      "kv_namespaces": [
        { "binding": "FRESHNESS", "id": "<production-kv-namespace-id>" }
      ]
    }
  }
}
