{
  // main: ./dist/_worker.js/index.js — omitted at build time (Astro adapter injects); custom entry in P4-E3
  "name": "immo-frontend",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/projects/*",
      "/listings/*",
      "/developers/*",
      "/fr/*",
      "/ar/*",
      "/en/*",
      "/__health"
    ]
  },
  "kv_namespaces": [
    { "binding": "FRESHNESS", "id": "<namespace-id>" }
  ]
}
