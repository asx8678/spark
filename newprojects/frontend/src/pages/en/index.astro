---
const environment = import.meta.env.PUBLIC_ENVIRONMENT ?? 'development';
const gitSha = import.meta.env.PUBLIC_GIT_SHA ?? 'local';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Immo Platform</title>
  </head>
  <body>
    <main>
      <h1>Immo Platform — staging Worker verification page</h1>
      <p>Staging verification page for Workers. Replaced by the real site in P2.</p>
      <dl>
        <dt>environment</dt>
        <dd>{environment}</dd>
        <dt>git_sha</dt>
        <dd>{gitSha}</dd>
      </dl>
      <p><a href="/__health">/__health</a></p>
    </main>
  </body>
</html>
