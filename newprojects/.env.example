# Copy to .env and fill in values. Never commit .env (see .gitignore).
# Authoritative registry: plan §12.4

# Domains (P0-E2.1)
PUBLIC_SITE_URL=https://staging.example.ma
DOMAIN=example.ma
STAGING_DOMAIN=staging.example.ma

# Cloudflare (P0-E2.1 / P0-E2.2)
CF_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_KV_NAMESPACE_ID_STAGING=
CF_KV_NAMESPACE_ID_PRODUCTION=

# P0-E3.1 — SSH hardening (infra/vps/bootstrap.sh, verify.sh)
SSH_PORT=2222

# Hetzner Cloud — server provision (infra/runbooks/vps-provision.md)
HETZNER_API_TOKEN=
HETZNER_SERVER_IP=
HETZNER_SERVER_NAME=immo-staging
HETZNER_LOCATION=fsn1
HETZNER_SERVER_TYPE=cpx31

# Backend (P0-E3+)
DATABASE_URL=ecto://immo:immo@localhost:5432/immo_dev
SECRET_KEY_BASE=
PHX_HOST=api.staging.example.ma
